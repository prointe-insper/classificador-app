# Configuração do backend (prefixo APP_). Copie para .env e ajuste se necessário.

# Caminho do artefato do modelo dentro do container.
APP_MODEL_PATH=/app/model/artifacts/model.joblib

# Limiar padrão de confiança para decidir "revisar manualmente" (0-1).
APP_DEFAULT_THRESHOLD=0.5

# Tamanho máximo de upload (MB).
APP_MAX_UPLOAD_MB=25

# OCR de PDFs escaneados / imagens (requer tesseract + poppler no container).
APP_OCR_ENABLED=true
APP_OCR_LANGUAGE=por

# Nº de termos retornados na explicação.
APP_EXPLAIN_TOP_K=12

# Origens permitidas no CORS (lista JSON).
APP_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
